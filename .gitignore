# Python caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test/tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.spec

# Local IDE/agent files
.vscode/
.idea/
.agents/
.codex/

# Runtime/local data
scores/
settings.json
*.log
*.prof

# Beatmaps and imports are user-provided runtime content.
songs/*
!songs/.gitkeep
imports/*
!imports/.gitkeep
*.osz

# OS files
Thumbs.db
Desktop.ini
